    #     document, created = (
    #         Document.objects.update_or_create(
    #             url=page["url"],
    #             defaults={
    #                 "title": page["title"],
    #                 "content": page["content"]
    #             }
    #         )
    #     )

    #     if created:

    #         print(
    #             "Document created."
    #         )

    #     else:

    #         print(
    #             "Document updated."
    #         )

    #     return document

    def save_document(self, page):

        new_hash = calculate_content_hash(
            page["title"],
            page["content"]
        )

        try:
            document = Document.objects.get(
                url=page["url"]
            )

            if document.content_hash == new_hash:

                print("Document unchanged.")

                return document, False

            document.title = page["title"]
            document.content = page["content"]
            document.content_hash = new_hash

            document.save()

            print("Document changed.")
            print("Updating search index.")

            self.index_manager.update_document(
                document
            )

            return document, True

        except Document.DoesNotExist:

            document = Document.objects.create(
                url=page["url"],
                title=page["title"],
                content=page["content"],
                content_hash=new_hash
            )

            print("Document created.")
            print("Adding to search index.")

            self.index_manager.add_document(
                document
            )

            return document, True
    def continuous_crawl(self, idle_seconds=60):

        print("\n==============================")
        print("CONTINUOUS CRAWLER STARTED")
        print("==============================")

        while True:

            # Retry failed URLs that are eligible
            retried = self.frontier.retry_failed()

            if retried:
                print(
                    f"Retried failed URLs: {retried}"
                )

            # Find work
            crawl_url = self.frontier.get_next()

            if crawl_url is None:

                print(
                    f"No URLs ready. "
                    f"Sleeping {idle_seconds} seconds..."
                )

                time.sleep(idle_seconds)

                continue

            print(
                f"\nURL ready for crawling:"
            )

            print(
                crawl_url.url
            )

            # Crawl exactly one URL
            self.max_pages = 1

            self.crawl()
    def crawl(self):

        pages_crawled = 0

        while (
            pages_crawled < self.max_pages
        ):
# old way 
            # crawl_url = (
            #     self.frontier.get_next()
            # )

            crawl_url = self.frontier.get_next()

            if crawl_url is None:
                crawl_url = self.frontier.get_next_due()

            if crawl_url is None:

                print(
                    "\nNo pending URLs."
                )

                break

            url = crawl_url.url

            print(
                f"\nCrawling: {url}"
            )

            if not self.robots.allowed(url):

                print(
                    "Blocked by robots.txt"
                )

                self.frontier.mark_failed(
                    crawl_url,
                    "Blocked by robots.txt"
                )

                continue

            self.frontier.mark_crawling(
                crawl_url
            )

            response = self.fetch(url)

            if response is None:

                self.frontier.mark_failed(
                    crawl_url,
                    "Request failed"
                )

                continue

            print(
                f"Status: "
                f"{response.status_code}"
            )

            if response.status_code != 200:

                self.frontier.mark_failed(
                    crawl_url,
                    f"HTTP {response.status_code}"
                )

                continue

            content_type = response.headers.get(
                "Content-Type",
                ""
            ).lower()

            if "text/html" not in content_type:

                self.frontier.mark_failed(
                    crawl_url,
                    f"Non-HTML content: {content_type}"
                )

                continue

            page = self.parse(
                url,
                response.text
            )

            print(
                f"Title: {page['title']}"
            )

            print(
                f"Characters: "
                f"{len(page['content'])}"
            )

            print(
                f"Links: "
                f"{len(page['links'])}"
            )

            #self.save_document(page)

            document, changed = self.save_document(page)

            if changed:
                print("Index updated.")

            else:
                print(
                    "Document unchanged. "
                    "Index update not required."
                )

# old way of drilling logic        
            # for link in page["links"]:

            #     self.frontier.add(
            #         link,
            #         depth=crawl_url.depth + 1
            #     )

            # new depth drilling logic
            if crawl_url.depth < self.max_depth:

                for link in page["links"]:

                    self.frontier.add(
                        link,
                        depth=crawl_url.depth + 1
                    )

            self.frontier.mark_completed(
                crawl_url
            )

            pages_crawled += 1

            print(
                f"Pages crawled: "
                f"{pages_crawled}"
            )

            time.sleep(
                self.delay
            )

        print(
            "\n=============================="
        )

        print(
            "DATABASE CRAWL COMPLETED"
        )

        print(
            "=============================="
        )

        print(
            f"Pages crawled: "
            f"{pages_crawled}"
        )

        print(
            f"Pending URLs: "
            f"{self.frontier.pending_count()}"
        )

        print(
            f"Completed URLs: "
            f"{self.frontier.completed_count()}"
        )
        print(self.max_pages)

if __name__ == "__main__":

    crawler = DatabaseCrawler(
        "https://www.tutorialspoint.com/",
        max_pages=5,
        delay=1.0
    )

    crawler.crawl()