import os
import time

# import hashlib
import django
import requests

from bs4 import BeautifulSoup
from urllib.parse import urljoin

os.environ.setdefault(
    "DJANGO_SETTINGS_MODULE",
    "config.settings"
)

django.setup()

from documents.models import Document
from search_core.database_frontier import DatabaseFrontier
from search_core.index_manager import IndexManager

from search_core.incremental_indexer import IncrementalIndexer
from search_core.content_hash import calculate_content_hash




from search_core.url_utils import (
    normalize_url,
    get_domain,
    is_same_domain
)
from search_core.robots import RobotsChecker


class DatabaseCrawler:

    USER_AGENT = "MySearchEngineBot/0.1"

    def __init__(
        self,
        seed_url,
        max_pages=10,
        delay=1.0,
        max_depth=3
    ):

        normalized_seed = normalize_url(
            seed_url
        )

        if not normalized_seed:
            raise ValueError(
                "Invalid seed URL"
            )

        self.seed_url = normalized_seed

        self.allowed_domain = get_domain(
            normalized_seed
        )

        self.max_pages = max_pages

        self.max_depth = max_depth
        
        self.delay = delay

        self.frontier = DatabaseFrontier()

        self.robots = RobotsChecker(
            normalized_seed,
            self.USER_AGENT
        )

        self.robots.load()

        self.frontier.add(
            normalized_seed,
            depth=0
        )

        self.index_manager = IndexManager()
        self.incremental_indexer = IncrementalIndexer(
            self.index_manager.index
        )


# hashing databse docs  -- not needed further
    # def calculate_content_hash(self, title, content):

    #     text = f"{title}\n{content}"

    #     return hashlib.sha256(
    #         text.encode("utf-8")
    #         ).hexdigest()


    def fetch(self, url):

        try:

            response = requests.get(
                url,
                timeout=10,
                headers={
                    "User-Agent": self.USER_AGENT
                }
            )

            return response

        except requests.RequestException as error:

            print(
                f"Request failed: {error}"
            )

            return None

    def parse(self, url, html):

        soup = BeautifulSoup(
            html,
            "html.parser"
        )

        # Remove elements that don't
        # represent useful page content.

        # older formating of document
        # for element in soup(
        #     ["script", "style", "noscript"]
        # ):
        #     element.decompose()
        for element in soup(
            [
                "script",
                "style",
                "noscript",
                "nav",
                "header",
                "footer",
                "aside"
            ]
        ):
            element.decompose()

        title = ""

        if soup.title:

            title = soup.title.get_text(
                strip=True
            )

        content = soup.get_text(
            separator=" ",
            strip=True
        )

        links = []

        for anchor in soup.find_all(
            "a",
            href=True
        ):

            absolute_url = urljoin(
                url,
                anchor["href"]
            )

            normalized_url = normalize_url(
                absolute_url
            )

            if not normalized_url:
                continue

            if not is_same_domain(
                normalized_url,
                self.allowed_domain
            ):
                continue

            links.append(
                normalized_url
            )

        return {
            "url": url,
            "title": title,
            "content": content,
            "links": links
        }
# this is old way to save document..
